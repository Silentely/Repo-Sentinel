# 复制为 .env 后填写。切勿提交真实 Secret。

# --- 必填 / 强烈建议 ---
REPOSENTINEL_PUBLIC_BASE_URL=https://monitor.example.com
REPOSENTINEL_ENCRYPTION_KEY= # openssl rand -base64 32
REPOSENTINEL_GITHUB_WEBHOOK_SECRET=

# --- 数据库（默认 SQLite；Compose 内已写死路径时可省略）---
# REPOSENTINEL_DATABASE_DRIVER=sqlite
# REPOSENTINEL_DATABASE_URL=file:/data/reposentinel.db
#
# 使用 PostgreSQL 时改为：
# REPOSENTINEL_DATABASE_DRIVER=postgres
# REPOSENTINEL_DATABASE_URL=postgres://user:pass@db:5432/reposentinel?sslmode=require
# REPOSENTINEL_DATABASE_MAX_OPEN_CONNS=10
# REPOSENTINEL_DATABASE_MAX_IDLE_CONNS=5

# --- HTTP ---
# REPOSENTINEL_HTTP_ADDR=0.0.0.0:8080

# --- 首次初始化（二选一：环境变量或 Web setup）---
REPOSENTINEL_ADMIN_USERNAME=
REPOSENTINEL_ADMIN_PASSWORD=
REPOSENTINEL_SETUP_ALLOW_REMOTE=false
# REPOSENTINEL_ADMIN_SESSION_TTL=24h

# --- GitHub App ---
# 也可登录后在管理台「GitHub App」页填写（未设环境变量的字段可网页保存；环境变量优先锁定）。
REPOSENTINEL_GITHUB_APP_ID=
REPOSENTINEL_GITHUB_CLIENT_ID=
REPOSENTINEL_GITHUB_PRIVATE_KEY_PATH=/secrets/github-app.pem
# REPOSENTINEL_GITHUB_WEBHOOK_PREVIOUS_SECRET=
# REPOSENTINEL_EXTERNAL_PAT=

# --- 通知 ---
REPOSENTINEL_TELEGRAM_TOKEN=
REPOSENTINEL_TELEGRAM_CHAT_ID=
# REPOSENTINEL_HTTP_WEBHOOK_URL=
# REPOSENTINEL_HTTP_WEBHOOK_SECRET=
# REPOSENTINEL_HTTP_WEBHOOK_ALLOW_PRIVATE=false

# --- 日志 ---
LOG_FORMAT=json
LOG_LEVEL=info
# 也可用 REPOSENTINEL_LOG_FORMAT / REPOSENTINEL_LOG_LEVEL

# --- Prometheus 指标（可选）---
# REPOSENTINEL_METRICS_ENABLED=true
# REPOSENTINEL_METRICS_TOKEN=

# --- 关于页远程更新检查（默认开启；内网可关）---
# REPOSENTINEL_UPDATE_CHECK=true
# REPOSENTINEL_UPDATE_CHECK_URL=https://api.github.com/repos/Silentely/Repo-Sentinel/releases/latest
# REPOSENTINEL_UPDATE_CHECK_TOKEN=

# --- 通知短时合并（多实例靠 Outbox 时间桶幂等；进程内合并仍为 best-effort）---
# REPOSENTINEL_AGGREGATION_WINDOW=60s
# REPOSENTINEL_AGGREGATION_BURST_THRESHOLD=15
# REPOSENTINEL_AGGREGATION_BURST_WINDOW=5m

# --- 主密钥轮换（仅轮换期间）---
# REPOSENTINEL_ENCRYPTION_KEY_PREVIOUS=
